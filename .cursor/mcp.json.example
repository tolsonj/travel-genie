{
  "mcpServers": {
    "serpapi-hotels": {
      "command": "npx",
      "args": ["-y", "serpapi-hotels-mcp-server"],
      "env": {
        "SERPAPI_API_KEY": "<your_key>"
      }
    },
    "serpapi-tripadvisor": {
      "command": "node",
      "args": ["mcp/tripadvisor-server/index.js"],
      "env": {
        "SERPAPI_API_KEY": "<your_key>"
      }
    },
    "fli": {
      "command": "fli-mcp",
      "args": [],
      "env": {}
    },
    "google-maps": {
      "command": "npx",
      "args": ["-y", "@cablate/mcp-google-map", "--stdio"],
      "env": {
        "GOOGLE_MAPS_API_KEY": "<your_key>",
        "GOOGLE_MAPS_ENABLED_TOOLS": "maps_geocode,maps_batch_geocode,maps_search_places,maps_place_details,maps_directions,maps_distance_matrix,maps_static_map,maps_plan_route"
      }
    }
  }
}
